{
	"npm": {
		"build": "node build.mjs",
		"lint": "npm run lint:css && npm run lint:js",
		"lint:fix": "npm run lint:css:fix && npm run lint:js:fix",
		"lint:css": "stylelint '**/*.css' --allow-empty-input",
		"lint:css:fix": "stylelint '**/*.css' --allow-empty-input --fix",
		"lint:js": "eslint .",
		"lint:js:fix": "eslint . --fix",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run cli --env-cwd=wp-content/plugins/{{slug}} vendor/bin/phpunit"
	},
	"composer": {
		"format": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf --report=summary,source",
		"lint": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
		"lint:summary": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --report=summary",
		"lint:errors": "@lint -n",
		"analyse": "@php ./vendor/bin/phpstan analyse --memory-limit=1G",
		"test": "@php ./vendor/bin/phpunit"
	}
}

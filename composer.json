{
	"name": "samiahmedsiddiqui/wp-plugin-tools",
	"description": "Shared tooling for WordPress plugins. The require-dev versions here are what bin/sync.mjs installs into each plugin.",
	"type": "project",
	"license": "GPL-3.0-or-later",
	"require-dev": {
		"squizlabs/php_codesniffer": "3.13.6",
		"wp-coding-standards/wpcs": "3.4.1",
		"phpcompatibility/phpcompatibility-wp": "2.1.8",
		"phpstan/phpstan": "2.3.4",
		"szepeviktor/phpstan-wordpress": "2.0.4",
		"phpstan/extension-installer": "1.4.3",
		"phpunit/phpunit": "9.6.38",
		"yoast/phpunit-polyfills": "4.0.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "7.4.33"
		}
	}
}
